# 配置模板（会提交到 git，不要写真实密钥）。
# 用法：复制为 server/.env（文件名就是 .env，没有其它扩展名），填入真实值；后端启动时自动读取，git 已忽略该文件。
# 格式：每行 KEY=VALUE，值不要加引号，等号两边不要空格。同名的系统环境变量优先于 .env。

# ---------------- AI（三项都存在时 health.aiConfigured=true）
# anthropic（默认，官方 Java SDK，走 /v1/messages）| openai（走 /v1/chat/completions）
AI_PROVIDER=anthropic
# anthropic：写到域名即可（带不带 /v1 都行）；openai：写到 /v1
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=claude-opus-5
# anthropic 协议鉴权头：x-api-key（默认）| bearer（中转站要求 Authorization: Bearer 时）
AI_AUTH=x-api-key
# 生成深度：low（默认，最快）| medium | high；中转站不认识 effort 时设为空
AI_EFFORT=low
# 中转站不支持 JSON Schema 结构化输出 / 服务端回退时，分别设为 false
AI_STRUCTURED_OUTPUT=true
AI_REFUSAL_FALLBACK=true

# ---------------- 设备：dryrun 只记录模拟事件；serial 需要 SERIAL_PORT（现场枚举确认，如 COM3）
DEVICE_MODE=dryrun
SERIAL_PORT=
